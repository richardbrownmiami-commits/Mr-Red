<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#08090b">
 <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="8dp" android:background="#111318">
  <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Learning Center" android:textColor="#ffffff" android:textSize="20sp" android:textStyle="bold"/>
  <Button android:id="@+id/learningRefresh" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Refresh"/>
 </LinearLayout>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="16dp">
  <TextView android:id="@+id/learningDashboard" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#e7e9ed" android:textSize="14sp" android:fontFamily="monospace" android:lineSpacingExtra="5dp"/>
 </ScrollView>
 <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:background="#111318">
  <Button android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Chat"/>
  <Button android:id="@+id/learningChatTab" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Learning • Active"/>
 </LinearLayout>
</LinearLayout>