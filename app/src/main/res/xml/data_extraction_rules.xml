<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep private event history, chat transcripts and diagnostic logs local-only. -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="mr_red_chat_history.xml" />
        <exclude domain="file" path="mr_red_activity.log" />
        <exclude domain="file" path="mr_red_native.log" />
    </cloud-backup>
    <device-transfer>
        <!-- Device-to-device migration follows the same privacy boundary. -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="mr_red_chat_history.xml" />
        <exclude domain="file" path="mr_red_activity.log" />
        <exclude domain="file" path="mr_red_native.log" />
    </device-transfer>
</data-extraction-rules>
